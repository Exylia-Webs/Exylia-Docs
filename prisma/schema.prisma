generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The public assistant's spend for one calendar month (UTC), every visitor together: the monthly
/// cap is checked against `tokens`. Every change is one atomic upsert, so several instances and
/// restarts add up instead of overwriting each other.
model AssistantUsage {
  /// `2026-11`
  month     String   @id
  tokens    BigInt   @default(0)
  /// Model calls (a visitor's question may take several).
  calls     Int      @default(0)
  /// Questions refused because the month's cap was spent.
  quotaHits Int      @default(0)
  updatedAt DateTime @default(now())
}

/// The same counts per day (UTC), for the admin panel's usage page. Written in the same statement
/// as the month's row.
model AssistantUsageDay {
  day       DateTime @id @db.Date
  tokens    BigInt   @default(0)
  calls     Int      @default(0)
  quotaHits Int      @default(0)
  updatedAt DateTime @default(now())
}
