# --- Build time (Coolify: build secrets) ---------------------------------------------------------
# Google Analytics / Microsoft Clarity, loaded only after cookie consent. Empty leaves them out.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# --- Run time: the database ----------------------------------------------------------------------
# PostgreSQL: the assistant's usage. Migrations run as the container starts.
DATABASE_URL="postgresql://docs:docs@localhost:5432/exylia_docs"

# --- Run time: the docs assistant ----------------------------------------------------------------
# Read by the server when it starts; no rebuild needed. AI_MODEL empty (or any value below invalid,
# logged at the first request) turns the assistant off: /api/assistant/ answers 404 and no button
# is drawn.
# openai | ollama | openrouter | anthropic
AI_PROVIDER=openai
# Empty: the provider's default endpoint. Ollama: http://host:11434 (with or without /v1).
AI_BASE_URL=
# Required for every provider but ollama. Never sent to the browser, redacted from the logs.
AI_API_KEY=
AI_MODEL=
# Output tokens per model call (64-64000). Default 1024.
AI_MAX_TOKENS=1024
# Per model call (1-600). Default 60.
AI_TIMEOUT_SECONDS=60
# Tokens (in + out) all visitors together may spend per calendar month (UTC). Default 2000000.
# 0 keeps the button but refuses every question.
AI_MONTHLY_TOKENS=2000000
# Where the month's token count was kept before the database; this month's is imported once. The
# Docker image sets /app/data.
AI_DATA_DIR=

# Cloudflare Turnstile in front of the assistant: set both keys, or neither (off).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Run time: the super admin panel (/admin) ----------------------------------------------------
# The address the site is served on, for the Discord redirect and the cookies' Secure/__Host-
# prefix. Empty: https://docs.exylia.net. In dev: http://localhost:3010.
PUBLIC_URL=
# Discord login for the ids listed below only. Register <PUBLIC_URL>/api/admin/auth/callback/ (with
# the trailing slash) as a redirect in the Discord application's OAuth2 settings.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comma-separated Discord user ids; empty lets nobody in. Checked on every request.
SUPER_ADMIN_DISCORD_IDS=
